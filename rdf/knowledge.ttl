@prefix ex: <https://example.org/knowledge-demo/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
ex:Ontology a owl:Ontology ; rdfs:comment "Synthetic educational data"@en, "Datos educativos sintéticos"@es .
ex:hasSymptom a owl:ObjectProperty .
ex:denotes a owl:AnnotationProperty .
ex:Disease a owl:Class ; rdfs:label "Disease"@en, "Enfermedad"@es .
ex:Symptom a owl:Class ; rdfs:label "Symptom"@en, "Síntoma"@es .
ex:RespiratoryDisease a owl:Class ; rdfs:label "Respiratory disease"@en, "Enfermedad respiratoria"@es .
ex:fever a owl:Class ; rdfs:label "Fever"@en, "Fiebre"@es .
ex:cough a owl:Class ; rdfs:label "Cough"@en, "Tos"@es .
ex:throat a owl:Class ; rdfs:label "Sore throat"@en, "Dolor de garganta"@es .
ex:headache a owl:Class ; rdfs:label "Headache"@en, "Cefalea"@es .
ex:nausea a owl:Class ; rdfs:label "Nausea"@en, "Náuseas"@es .
ex:ExampleCold a owl:Class ; rdfs:label "Example common cold"@en, "Resfriado de ejemplo"@es .
ex:ExampleFlu a owl:Class ; rdfs:label "Example influenza"@en, "Gripe de ejemplo"@es .
ex:ExampleMigraine a owl:Class ; rdfs:label "Example migraine"@en, "Migraña de ejemplo"@es .
ex:ColdWeather a owl:Class ; rdfs:label "Cold weather"@en, "Temperatura ambiental fría"@es .
ex:ColdSensation a owl:Class ; rdfs:label "Feeling cold"@en, "Sensación de frío"@es .
ex:RespiratoryDisease rdfs:subClassOf ex:Disease .
ex:fever rdfs:subClassOf ex:Symptom .
ex:cough rdfs:subClassOf ex:Symptom .
ex:throat rdfs:subClassOf ex:Symptom .
ex:headache rdfs:subClassOf ex:Symptom .
ex:nausea rdfs:subClassOf ex:Symptom .
ex:ExampleCold rdfs:subClassOf ex:RespiratoryDisease .
ex:ExampleCold rdfs:subClassOf [ a owl:Restriction ; owl:onProperty ex:hasSymptom ; owl:someValuesFrom ex:fever ] .
ex:ExampleCold rdfs:subClassOf [ a owl:Restriction ; owl:onProperty ex:hasSymptom ; owl:someValuesFrom ex:cough ] .
ex:ExampleCold rdfs:subClassOf [ a owl:Restriction ; owl:onProperty ex:hasSymptom ; owl:someValuesFrom ex:throat ] .
ex:ExampleFlu rdfs:subClassOf ex:RespiratoryDisease .
ex:ExampleFlu rdfs:subClassOf [ a owl:Restriction ; owl:onProperty ex:hasSymptom ; owl:someValuesFrom ex:fever ] .
ex:ExampleFlu rdfs:subClassOf [ a owl:Restriction ; owl:onProperty ex:hasSymptom ; owl:someValuesFrom ex:cough ] .
ex:ExampleFlu rdfs:subClassOf [ a owl:Restriction ; owl:onProperty ex:hasSymptom ; owl:someValuesFrom ex:headache ] .
ex:ExampleMigraine rdfs:subClassOf ex:Disease .
ex:ExampleMigraine rdfs:subClassOf [ a owl:Restriction ; owl:onProperty ex:hasSymptom ; owl:someValuesFrom ex:headache ] .
ex:ExampleMigraine rdfs:subClassOf [ a owl:Restriction ; owl:onProperty ex:hasSymptom ; owl:someValuesFrom ex:nausea ] .
ex:term0 rdfs:label "cefalea"@es .
ex:term0 ex:denotes ex:headache .
ex:term1 rdfs:label "cold"@en .
ex:term1 ex:denotes ex:ColdWeather .
ex:term1 ex:denotes ex:ColdSensation .
ex:term1 ex:denotes ex:ExampleCold .
ex:term2 rdfs:label "cough"@en .
ex:term2 ex:denotes ex:cough .
ex:term3 rdfs:label "dolor de cabeza"@es .
ex:term3 ex:denotes ex:headache .
ex:term4 rdfs:label "dolor de garganta"@es .
ex:term4 ex:denotes ex:throat .
ex:term5 rdfs:label "fever"@en .
ex:term5 ex:denotes ex:fever .
ex:term6 rdfs:label "fiebre"@es .
ex:term6 ex:denotes ex:fever .
ex:term7 rdfs:label "frío"@es .
ex:term7 ex:denotes ex:ColdWeather .
ex:term7 ex:denotes ex:ColdSensation .
ex:term8 rdfs:label "head pain"@en .
ex:term8 ex:denotes ex:headache .
ex:term9 rdfs:label "headache"@en .
ex:term9 ex:denotes ex:headache .
ex:term10 rdfs:label "nausea"@en .
ex:term10 ex:denotes ex:nausea .
ex:term11 rdfs:label "náusea"@es .
ex:term11 ex:denotes ex:nausea .
ex:term12 rdfs:label "náuseas"@es .
ex:term12 ex:denotes ex:nausea .
ex:term13 rdfs:label "sore throat"@en .
ex:term13 ex:denotes ex:throat .
ex:term14 rdfs:label "tos"@es .
ex:term14 ex:denotes ex:cough .
