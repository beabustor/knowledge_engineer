{
  "name": "knowledge-engineer-web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test ../02-model/*.test.ts ../03-pipelines/01-impact/*.test.ts ../03-pipelines/02-interview/*.test.ts adapters/*.test.ts ../06-examples/typescript/demo.test.ts",
    "format:check": "cd .. && 04-app/node_modules/.bin/prettier --check \"02-model/**/*.ts\" \"03-pipelines/**/*.ts\" \"04-app/**/*.ts\" \"04-app/styles/*.css\" \"04-app/index.html\" --ignore-path .prettierignore"
  },
  "devDependencies": {
    "@types/sql.js": "^1.4.11",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  },
  "dependencies": {
    "@e965/xlsx": "0.20.3",
    "sql.js": "^1.15.1"
  }
}
