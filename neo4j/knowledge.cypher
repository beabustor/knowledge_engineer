MERGE (c:KnowledgeDemo:Concept {id: "Disease"}) SET c.label = "Enfermedad";
MERGE (c:KnowledgeDemo:Concept {id: "Symptom"}) SET c.label = "Síntoma";
MERGE (c:KnowledgeDemo:Concept {id: "RespiratoryDisease"}) SET c.label = "Enfermedad respiratoria";
MERGE (c:KnowledgeDemo:Concept {id: "fever"}) SET c.label = "fiebre";
MERGE (c:KnowledgeDemo:Concept {id: "cough"}) SET c.label = "tos";
MERGE (c:KnowledgeDemo:Concept {id: "throat"}) SET c.label = "dolor de garganta";
MERGE (c:KnowledgeDemo:Concept {id: "headache"}) SET c.label = "cefalea";
MERGE (c:KnowledgeDemo:Concept {id: "nausea"}) SET c.label = "náuseas";
MERGE (c:KnowledgeDemo:Concept {id: "ExampleCold"}) SET c.label = "Resfriado de ejemplo";
MERGE (c:KnowledgeDemo:Concept {id: "ExampleFlu"}) SET c.label = "Gripe de ejemplo";
MERGE (c:KnowledgeDemo:Concept {id: "ExampleMigraine"}) SET c.label = "Migraña de ejemplo";
MERGE (c:KnowledgeDemo:Concept {id: "ColdWeather"}) SET c.label = "ColdWeather";
MERGE (c:KnowledgeDemo:Concept {id: "ColdSensation"}) SET c.label = "ColdSensation";
MATCH (a:KnowledgeDemo:Concept {id: "RespiratoryDisease"}), (b:KnowledgeDemo:Concept {id: "Disease"}) MERGE (a)-[:IS_A]->(b);
MATCH (a:KnowledgeDemo:Concept {id: "fever"}), (b:KnowledgeDemo:Concept {id: "Symptom"}) MERGE (a)-[:IS_A]->(b);
MATCH (a:KnowledgeDemo:Concept {id: "cough"}), (b:KnowledgeDemo:Concept {id: "Symptom"}) MERGE (a)-[:IS_A]->(b);
MATCH (a:KnowledgeDemo:Concept {id: "throat"}), (b:KnowledgeDemo:Concept {id: "Symptom"}) MERGE (a)-[:IS_A]->(b);
MATCH (a:KnowledgeDemo:Concept {id: "headache"}), (b:KnowledgeDemo:Concept {id: "Symptom"}) MERGE (a)-[:IS_A]->(b);
MATCH (a:KnowledgeDemo:Concept {id: "nausea"}), (b:KnowledgeDemo:Concept {id: "Symptom"}) MERGE (a)-[:IS_A]->(b);
MATCH (a:KnowledgeDemo:Concept {id: "ExampleCold"}), (b:KnowledgeDemo:Concept {id: "RespiratoryDisease"}) MERGE (a)-[:IS_A]->(b);
MATCH (a:KnowledgeDemo:Concept {id: "ExampleCold"}), (b:KnowledgeDemo:Concept {id: "fever"}) MERGE (a)-[:HAS_SYMPTOM]->(b);
MATCH (a:KnowledgeDemo:Concept {id: "ExampleCold"}), (b:KnowledgeDemo:Concept {id: "cough"}) MERGE (a)-[:HAS_SYMPTOM]->(b);
MATCH (a:KnowledgeDemo:Concept {id: "ExampleCold"}), (b:KnowledgeDemo:Concept {id: "throat"}) MERGE (a)-[:HAS_SYMPTOM]->(b);
MATCH (a:KnowledgeDemo:Concept {id: "ExampleFlu"}), (b:KnowledgeDemo:Concept {id: "RespiratoryDisease"}) MERGE (a)-[:IS_A]->(b);
MATCH (a:KnowledgeDemo:Concept {id: "ExampleFlu"}), (b:KnowledgeDemo:Concept {id: "fever"}) MERGE (a)-[:HAS_SYMPTOM]->(b);
MATCH (a:KnowledgeDemo:Concept {id: "ExampleFlu"}), (b:KnowledgeDemo:Concept {id: "cough"}) MERGE (a)-[:HAS_SYMPTOM]->(b);
MATCH (a:KnowledgeDemo:Concept {id: "ExampleFlu"}), (b:KnowledgeDemo:Concept {id: "headache"}) MERGE (a)-[:HAS_SYMPTOM]->(b);
MATCH (a:KnowledgeDemo:Concept {id: "ExampleMigraine"}), (b:KnowledgeDemo:Concept {id: "Disease"}) MERGE (a)-[:IS_A]->(b);
MATCH (a:KnowledgeDemo:Concept {id: "ExampleMigraine"}), (b:KnowledgeDemo:Concept {id: "headache"}) MERGE (a)-[:HAS_SYMPTOM]->(b);
MATCH (a:KnowledgeDemo:Concept {id: "ExampleMigraine"}), (b:KnowledgeDemo:Concept {id: "nausea"}) MERGE (a)-[:HAS_SYMPTOM]->(b);
MERGE (t:KnowledgeDemo:Term {label: "cefalea"}) WITH t MATCH (c:KnowledgeDemo:Concept {id: "headache"}) MERGE (t)-[:DENOTES]->(c);
MERGE (t:KnowledgeDemo:Term {label: "dolor de cabeza"}) WITH t MATCH (c:KnowledgeDemo:Concept {id: "headache"}) MERGE (t)-[:DENOTES]->(c);
MERGE (t:KnowledgeDemo:Term {label: "dolor de garganta"}) WITH t MATCH (c:KnowledgeDemo:Concept {id: "throat"}) MERGE (t)-[:DENOTES]->(c);
MERGE (t:KnowledgeDemo:Term {label: "fiebre"}) WITH t MATCH (c:KnowledgeDemo:Concept {id: "fever"}) MERGE (t)-[:DENOTES]->(c);
MERGE (t:KnowledgeDemo:Term {label: "frío"}) WITH t MATCH (c:KnowledgeDemo:Concept {id: "ColdWeather"}) MERGE (t)-[:DENOTES]->(c);
MERGE (t:KnowledgeDemo:Term {label: "frío"}) WITH t MATCH (c:KnowledgeDemo:Concept {id: "ColdSensation"}) MERGE (t)-[:DENOTES]->(c);
MERGE (t:KnowledgeDemo:Term {label: "náusea"}) WITH t MATCH (c:KnowledgeDemo:Concept {id: "nausea"}) MERGE (t)-[:DENOTES]->(c);
MERGE (t:KnowledgeDemo:Term {label: "náuseas"}) WITH t MATCH (c:KnowledgeDemo:Concept {id: "nausea"}) MERGE (t)-[:DENOTES]->(c);
MERGE (t:KnowledgeDemo:Term {label: "tos"}) WITH t MATCH (c:KnowledgeDemo:Concept {id: "cough"}) MERGE (t)-[:DENOTES]->(c);
